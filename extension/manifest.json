{
  "manifest_version": 3,
  "name": "Authentica — AI Media Protection",
  "version": "1.0.0",
  "description": "Quick warning tool detecting synthetic media, voice clones, and social engineering fraud on the active tab.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Authentica — AI Media Protection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "tabs",
    "offscreen",
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
